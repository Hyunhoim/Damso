# Prefer scripts/init-local-env.py to create unique local secrets.
PROJECT_NAME=Damso API
FRONTEND_HOST=http://localhost:8081
SECRET_KEY=
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=
POSTGRES_PASSWORD=
# Example format: postgresql://postgres:<password>@127.0.0.1:5433/app
DATABASE_URL=
BACKEND_CORS_ORIGINS=["http://127.0.0.1:8081"]
# Optional overrides:
# STORAGE_ROOT=/path/to/private/audio
# MAX_AUDIO_BYTES=26214400
# MAX_AUDIO_SECONDS=600
# Development UI is opt-in; run-local.py enables it only for loopback access.
# ENABLE_LLM_SETUP_UI=false
# CLOVA_CONFIG_FILE=/path/to/private/clova.json
# CLOVA_SPEECH_CONFIG_FILE=/path/to/private/clova-speech.json
# SMTP is intentionally unset. Email delivery needs a separate configuration.
